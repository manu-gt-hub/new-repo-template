# Secrets and local environment (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials*.json

# Live harness state is committed in generated projects, not in the template.
# TEMPLATE-ONLY: bootstrap deletes this comment line and the line below it.
.harness/state/

# Harness scratch files
issue-map.json
backlog.local.json

# Claude Code local settings
.claude/settings.local.json

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Common build / dependency output (extend for your stack)
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
.venv/
.pytest_cache/
