# .harness/env/sandbox.config
#
# Configuration of the agent's execution environment.
# Format: bash-sourceable KEY="VALUE" lines only (no commands, no logic).
# Read by: .githooks/*, .harness/hooks/*, tests/harness/run.sh, CI.
#
# Fill the project commands during bootstrap once the stack is chosen.
# An empty command is SKIPPED with a warning (never silently treated as "passed").

# ---------------------------------------------------------------------------
# Project commands
# ---------------------------------------------------------------------------
# Examples:
#   Node:   LINT_CMD="npm run lint"   FORMAT_CHECK_CMD="npx prettier --check ."  TEST_CMD="npm test"
#   Python: LINT_CMD="ruff check ."   FORMAT_CHECK_CMD="ruff format --check ."   TEST_CMD="pytest"
#   Go:     LINT_CMD="golangci-lint run"  FORMAT_CHECK_CMD="test -z \"$(gofmt -l .)\""  TEST_CMD="go test ./..."
LINT_CMD=""
FORMAT_CHECK_CMD=""
TYPECHECK_CMD=""
# The harness self-test always runs; append the project test command, e.g.
#   TEST_CMD="bash tests/harness/run.sh && npm test"
TEST_CMD="bash tests/harness/run.sh"
BUILD_CMD=""

# ---------------------------------------------------------------------------
# Git policy
# ---------------------------------------------------------------------------
# Branches the agent must not commit/push to directly (after bootstrap).
PROTECTED_BRANCHES="main master"
# Branch naming convention (regex) checked by pre-agent.sh as a warning.
BRANCH_PATTERN="^(feat|fix|chore|docs|refactor|test|perf|ci|build|spike)/[0-9]+-[a-z0-9-]+$"
# Enforce Conventional Commits in the commit-msg hook (1 = yes, 0 = no).
ENFORCE_CONVENTIONAL_COMMITS="1"
# pre-commit refuses commits on PROTECTED_BRANCHES (1 = yes). One-off override, only when
# the user explicitly asked (e.g. during bootstrap): HARNESS_ALLOW_PROTECTED_COMMIT=1 git commit ...
BLOCK_COMMITS_ON_PROTECTED="1"
# pre-commit also runs TEST_CMD (1 = yes). Lint/format/typecheck always run.
PRE_COMMIT_RUN_TESTS="0"

# ---------------------------------------------------------------------------
# Guardrails (what the agent may do is defined by the golden rules in AGENTS.md
# and enforced in .claude/settings.json; these values are enforced by the hooks)
# ---------------------------------------------------------------------------
# Paths that must never be committed (space-separated globs).
FORBIDDEN_PATHS=".env .env.* *.pem *.key *.p12 secrets/ credentials*.json"

# Extended regex used by pre-commit / post-agent to detect secrets in diffs.
# Matches only ADDED lines. This file itself is excluded from the scan.
SECRET_PATTERNS="(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*[\"'][^\"'[:space:]]{8,}[\"'])"

# ---------------------------------------------------------------------------
# Hook behaviour
# ---------------------------------------------------------------------------
# What post-agent.sh runs at the end of a session: none | lint | all
POST_AGENT_CHECKS="lint"
# 1 = post-agent.sh blocks the agent from stopping when checks fail (Claude Code Stop hook).
HARNESS_STRICT="0"
