#!/usr/bin/env bash
# .githooks/post-rewrite — after a rebase, tell whether the generated docs need a rebuild
# (rebases replay commits without hooks, so docs-site/ can end up stale). Never blocks.

[ "${1:-}" = "rebase" ] || exit 0
ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=../.harness/hooks/lib.sh
. "$ROOT/.harness/hooks/lib.sh"
py="$(h_python)" || exit 0
if ! "$py" "$ROOT/.harness/scripts/build_docs.py" --check >/dev/null 2>&1; then
  h_warn "Generated docs are stale after the rebase. Run: python .harness/scripts/build_docs.py && git commit -am \"chore(docs): regenerate docs\""
fi
exit 0
