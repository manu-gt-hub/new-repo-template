#!/usr/bin/env bash
# Install once per clone: git config core.hooksPath .githooks
# Blocks commits on main/master, commits with secrets or secret files, and failing checks.
# Never bypass with --no-verify.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

branch="$(git rev-parse --abbrev-ref HEAD)"
if { [ "$branch" = "main" ] || [ "$branch" = "master" ]; } && [ "${ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
  echo "pre-commit: commits on '$branch' are blocked. Create a branch (or ALLOW_MAIN_COMMIT=1 if explicitly intended)."
  exit 1
fi

files="$(git diff --cached --name-only --diff-filter=ACMR)"
bad_files="$(printf '%s\n' "$files" | grep -E '(^|/)(\.env(\..*)?|.*\.(pem|key|p12)|credentials.*\.json)$|(^|/)secrets/' | grep -vE '\.(example|sample|template)$' || true)"
if [ -n "$bad_files" ]; then
  echo "pre-commit: secret files staged:"; printf '  %s\n' $bad_files; exit 1
fi

secrets='(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35})'
hits="$(git diff --cached -U0 --no-color -- . ':(exclude).githooks/pre-commit' | grep -E '^\+[^+]' | grep -nE "$secrets" || true)"
if [ -n "$hits" ]; then
  echo "pre-commit: possible secrets in staged changes:"; printf '%s\n' "$hits" | head -n 10; exit 1
fi

SKIP_TESTS=1 bash scripts/check.sh || { echo "pre-commit: checks failed. Fix them; do not bypass the hook."; exit 1; }
