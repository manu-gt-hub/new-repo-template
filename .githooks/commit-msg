#!/usr/bin/env bash
# Enforces Conventional Commits: <type>(<scope>)!: <description>
first_line="$(grep -v '^#' "$1" | head -n 1)"
case "$first_line" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: not a Conventional Commit: '$first_line'"
  echo "  expected: <type>(<scope>): <description>   types: feat fix chore docs style refactor perf test build ci revert"
  exit 1
fi
