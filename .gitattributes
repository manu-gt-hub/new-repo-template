# Normalize line endings; shell scripts and hooks must be LF to run on any OS.
* text=auto eol=lf
*.sh text eol=lf
.githooks/* text eol=lf
*.config text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated / vendored files: collapsed in GitHub diffs, excluded from language stats.
docs-site/** linguist-generated=true -diff
docs/backlog/index.md linguist-generated=true
.harness/docs-viewer/vendor/** linguist-vendored=true -diff

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
